{
    "manifest_version": 3,
    "name": "LeetCode Motivator",
    "version": "1.0",
    "description": "Get motivated when you're stuck.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://leetcode.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}